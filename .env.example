# =============================================================================
# CareBuddy Environment Configuration (.env.example)
# Do not place real production credentials in this file.
# Copy to .env and adjust values for your environment.
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carebuddy?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/carebuddy_test?schema=public

# Database Port for Docker Compose / Local Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carebuddy
POSTGRES_PORT=5432

# Security & Cryptography
SESSION_SECRET=replace_with_64_char_random_hex_string_in_production_min_32_bytes
INVITATION_PEPPER=replace_with_secure_hmac_secret_pepper_in_production

# AI Assistant Integration (Server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Feature Toggles & Demo Mode
DEMO_MODE=true

# Background Worker Settings
WORKER_POLL_INTERVAL_MS=5000
WORKER_HEARTBEAT_INTERVAL_MS=10000
