{
  "name": "carebuddy-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@carebuddy/api run dev",
    "dev:web": "npm --workspace=@carebuddy/web run dev",
    "worker": "npm --workspace=@carebuddy/api run worker",
    "db:local": "node scripts/run-pg.js",
    "verify:stage1": "node scripts/verify-migration.js",
    "verify:stage3": "node scripts/verify-stage3.js",
    "prisma:generate": "npm --workspace=@carebuddy/api run prisma:generate",
    "prisma:migrate": "npm --workspace=@carebuddy/api run prisma:migrate",
    "test": "npm --workspace=@carebuddy/api run test"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "pg": "^8.13.1"
  }
}